# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development        # development | production | test

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local:   mongodb://localhost:27017/products_db
# Atlas:   mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/products_db
MONGODB_URI=mongodb://localhost:27017/products_db

# ─── Logging ──────────────────────────────────────────────────────────────────
# Morgan format: combined | common | dev | short | tiny
LOG_FORMAT=dev
